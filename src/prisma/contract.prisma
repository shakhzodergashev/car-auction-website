model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  firstName    String
  lastName     String
  passwordHash String
  phoneNumber  String   @unique
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())
}

enum Role {
  BUYER
  MANAGER
  ADMIN
}
